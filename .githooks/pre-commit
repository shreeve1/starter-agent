#!/usr/bin/env python3
import hashlib
import json
import pathlib
import re
import subprocess
import sys

PATTERNS = [
    ("private key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("credential assignment", re.compile(
        r"(?i)\b(password|passwd|pwd|passphrase|secret|client[_-]?secret|api[_-]?key|access[_-]?key|token|psk|wifi key)\b\s*[:=]\s*['\"]?(?!value\b|<|\$|\{|\(|\*)[^\s'\"()<>`|]{6,}")),
    ("bearer token", re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]{20,}")),
    ("jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}")),
    ("aws key", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("github token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}\b")),
    ("slack token", re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}")),
]


def test_dirs(root=pathlib.Path(".")):
    found = [root / ".githooks/tests", *root.glob(".agents/skills/*/tests"), *root.glob(".agents/skills/*/scripts/tests")]
    return sorted(str(p) for p in found if p.is_dir())


def staged_added_lines():
    diff = subprocess.run(
        ["git", "diff", "--cached", "-U0", "--no-color", "--no-ext-diff",
         "--src-prefix=a/", "--dst-prefix=b/", "--diff-filter=AM"],
        capture_output=True, encoding="utf-8", errors="replace", check=True,
    ).stdout
    path = None
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("+") and not line.startswith("+++") and path:
            yield path, line[1:]


def reviewed_lines(root=pathlib.Path(".")):
    """Exact lines (by sha256 of the stripped text) a maintainer reviewed as non-secrets, per path prefix."""
    p = root / ".githooks/secret-allow.json"
    if not p.is_file():
        return []
    return json.loads(p.read_text(encoding="utf-8")).get("reviewed", [])


def is_reviewed(path, text, reviewed):
    digest = hashlib.sha256(text.strip().encode("utf-8")).hexdigest()
    return any(path.startswith(r["prefix"]) and digest in r["line_sha256"] for r in reviewed)


def staged_paths():
    """Every staged path, old and new side, for adds, edits, deletes and renames."""
    out = subprocess.run(["git", "diff", "--cached", "--name-status", "--no-renames", "-z"],
                         capture_output=True, encoding="utf-8", errors="replace", check=True).stdout.split("\0")
    return [p for p in out[1::2] if p]


def client_folder(root=pathlib.Path(".")):
    """The folder name memory/schema.json gives the owner's tracked things (`client_folder`), default `clients`."""
    try:
        name = json.loads((root / "memory/schema.json").read_text(encoding="utf-8")).get("client_folder")
    except (OSError, ValueError, AttributeError):
        name = None
    return name if isinstance(name, str) and name else "clients"


def needs_memory_audit(paths):
    """Memory, client notes and skills (rules.md names skills) all feed the audit."""
    return any(p.startswith(("memory/", "clients/", client_folder() + "/", ".agents/skills/")) for p in paths)


def main():
    hits = []
    reviewed = reviewed_lines()
    for path, text in staged_added_lines():
        for name, pattern in PATTERNS:
            if pattern.search(text) and (name == "private key" or not is_reviewed(path, text, reviewed)):
                hits.append(f"{path}: {name}: {text.strip()[:80]}")
    if hits:
        print("pre-commit: possible secret in staged changes. Remove it, or commit with --no-verify if it is a false positive.", file=sys.stderr)
        for hit in hits[:20]:
            print("  " + hit, file=sys.stderr)
        return 1
    staged = staged_paths()
    gate = pathlib.Path(".agents/skills/personal-memory/gate.py")
    if gate.exists() and needs_memory_audit(staged):
        audit = subprocess.run([sys.executable, str(gate), "--memory", "memory", "audit"], capture_output=True, encoding="utf-8", errors="replace")
        if audit.returncode != 0:
            print("pre-commit: memory audit failed. Run hubs.py and fix the issues below.", file=sys.stderr)
            print(audit.stdout + audit.stderr, file=sys.stderr)
            return 1
        warnings = [l for l in audit.stdout.splitlines() if l.startswith("Warning:")]
        if warnings:
            print("pre-commit: memory warnings (not blocking). Trim any file this session touched:", file=sys.stderr)
            print("\n".join(warnings), file=sys.stderr)
    if any(p.startswith((".agents/skills/", ".githooks/")) for p in staged):
        for tests in test_dirs():
            run = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", tests, "-q"], capture_output=True, encoding="utf-8", errors="replace")
            if run.returncode not in (0, 5):  # 5 = no unittest tests in that folder (for example other test frameworks)
                print(f"pre-commit: tests failed in {tests}.", file=sys.stderr)
                print(run.stderr[-4000:], file=sys.stderr)
                return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
